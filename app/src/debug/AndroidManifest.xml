<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay: allow cleartext (ws://) WebSocket traffic so the debug
  build can connect to a locally running nodeterm relay on the LAN.
  Release builds are unaffected and stay locked down (no cleartext).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true" />

</manifest>
